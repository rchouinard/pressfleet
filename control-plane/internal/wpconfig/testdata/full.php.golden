define( 'WP_REDIS_DATABASE', 7 );
// Must match the ACL user's key pattern, colon included.
define( 'WP_REDIS_PREFIX', '01jabc:' );
// The database holds only this site's keys, so a flush is a FLUSHDB
// rather than a script scanning the keyspace for the prefix.
define( 'WP_REDIS_SELECTIVE_FLUSH', false );
// phpredis is built with igbinary: smaller entries in the shared cache.
define( 'WP_REDIS_IGBINARY', true );
// The platform monitors the cache (§7); the plugin's per-request metrics
