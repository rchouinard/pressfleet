// ** Platform ** //
// Must-use plugins ship in the site image, outside wp-content, so they are
// versioned with the image and can't be removed from within WordPress.
define( 'WPMU_PLUGIN_DIR', '/opt/pressfleet/mu-plugins' );
// Root-relative, so it stays valid when the site's domain changes.
define( 'WPMU_PLUGIN_URL', '/_pressfleet/mu-plugins' );
// Core is root-owned and read-only; without this WordPress's ownership
// check would ask for FTP credentials to update plugins and themes.
define( 'FS_METHOD', 'direct' );
// Core updates ship as new site images (§5.5).
define( 'WP_AUTO_UPDATE_CORE', false );
// The control plane's scheduler runs WP-Cron (§5.6).
define( 'DISABLE_WP_CRON', true );
// Nginx Helper purges the FastCGI cache in this volume, shared with nginx.
define( 'RT_WP_NGINX_HELPER_CACHE_PATH', '/var/cache/pressfleet/fastcgi' );
// HTTPS behind the reverse proxy needs no code here: nginx sets HTTPS=on
// for requests a trusted proxy forwarded over HTTPS. WP_HOME and
// WP_SITEURL are deliberately not defined; go-live changes the site's URL
// in the database (§5.2).

// ** Object cache (Redis Object Cache plugin) ** //
