# Custom domain routes of PressFleet site 01k5z3m8q9r7t6v5w4x3y2z1ab (design doc §5.2).
#
# Generated by the control plane. A copy is in Traefik's file provider
# directory while the site is live. Do not edit: changes are overwritten the
# next time the site is rendered.
http:
    middlewares:
        pf-01k5z3m8q9r7t6v5w4x3y2z1ab-alias-redirect:
            redirectRegex:
                permanent: true
                regex: ^https?://[^/]+(.*)$
                replacement: https://www.acme.example${1}
        pf-01k5z3m8q9r7t6v5w4x3y2z1ab-hsts:
            headers:
                stsSeconds: 31536000
        pf-01k5z3m8q9r7t6v5w4x3y2z1ab-noindex:
            headers:
                customResponseHeaders:
                    X-Robots-Tag: noindex
        pf-01k5z3m8q9r7t6v5w4x3y2z1ab-preview-auth:
            basicAuth:
                realm: Preview
                removeHeader: true
                users:
                    - preview:$2a$04$abcdefghijklmnopqrstuuq5MvA9Wh8m6cHfVZ1gXWLU4.o9rSPTa
        pf-01k5z3m8q9r7t6v5w4x3y2z1ab-preview-redirect:
            redirectRegex:
                permanent: true
                regex: ^https?://[^/]+(.*)$
                replacement: https://www.acme.example${1}
    routers:
        pf-01k5z3m8q9r7t6v5w4x3y2z1ab-alias-54667cc7be:
            rule: Host(`acme.example`)
            entryPoints:
                - websecure
            middlewares:
                - pf-01k5z3m8q9r7t6v5w4x3y2z1ab-hsts
                - pf-01k5z3m8q9r7t6v5w4x3y2z1ab-alias-redirect
            service: pf-01k5z3m8q9r7t6v5w4x3y2z1ab@docker
            tls:
                certResolver: acme-http
        pf-01k5z3m8q9r7t6v5w4x3y2z1ab-alias-d812217621:
            rule: Host(`shop.acme.example`)
            entryPoints:
                - websecure
            middlewares:
                - pf-01k5z3m8q9r7t6v5w4x3y2z1ab-hsts
                - pf-01k5z3m8q9r7t6v5w4x3y2z1ab-alias-redirect
            service: pf-01k5z3m8q9r7t6v5w4x3y2z1ab@docker
            tls:
                certResolver: acme-http
        pf-01k5z3m8q9r7t6v5w4x3y2z1ab-preview-redirect:
            rule: Host(`acme.preview.example.com`)
            entryPoints:
                - websecure
            priority: 10000
            middlewares:
                - pf-01k5z3m8q9r7t6v5w4x3y2z1ab-noindex
                - pf-01k5z3m8q9r7t6v5w4x3y2z1ab-preview-auth
                - pf-01k5z3m8q9r7t6v5w4x3y2z1ab-preview-redirect
            service: pf-01k5z3m8q9r7t6v5w4x3y2z1ab@docker
            tls:
                certResolver: acme-preview
        pf-01k5z3m8q9r7t6v5w4x3y2z1ab-primary:
            rule: Host(`www.acme.example`)
            entryPoints:
                - websecure
            middlewares:
                - pf-01k5z3m8q9r7t6v5w4x3y2z1ab-hsts
            service: pf-01k5z3m8q9r7t6v5w4x3y2z1ab@docker
            tls:
                certResolver: acme-http
