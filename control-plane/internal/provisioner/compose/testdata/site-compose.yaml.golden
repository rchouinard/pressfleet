# PressFleet site 01k5z3m8q9r7t6v5w4x3y2z1ab (design doc §4.1).
#
# Generated by the control plane from the site's record. Do not edit: changes
# are overwritten the next time the site is rendered. The site's credentials
# are in ./wp-config.php (mounted into php only), never in this file.
name: "pf-01k5z3m8q9r7t6v5w4x3y2z1ab"

x-logging: &logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

# Settings both site containers share. They run as the site's own UID and GID
# (§6), which must be the same in both: nginx reads the files PHP writes to
# wp-content, and PHP deletes nginx's FastCGI cache files (§5.6). Neither
# image needs root, capabilities, or a writable root filesystem.
x-site-container: &site-container
  user: "20042:20042"
  restart: unless-stopped
  read_only: true
  tmpfs:
    - /tmp
  cap_drop:
    - ALL
  security_opt:
    - "no-new-privileges:true"
  networks:
    - site
  logging: *logging

services:
  php:
    <<: *site-container
    image: "ghcr.io/rchouinard/pressfleet/site-php:php8.4-wp7.1.2"
    labels:
      pressfleet.managed: "true"
      pressfleet.site-id: "01k5z3m8q9r7t6v5w4x3y2z1ab"
      pressfleet.client-group-id: "01k5z3m8q9r7t6v5w4x3y2z1cg"
    environment:
      # Derived from php's memory limit (compose.splitResources).
      PHP_MEMORY_LIMIT: "256M"
      PHP_FPM_MAX_CHILDREN: "6"
    volumes:
      - type: volume
        source: wp-content
        target: /var/www/wordpress/wp-content
      - type: volume
        source: cache
        target: /var/cache/pressfleet/fastcgi
      # A single-file bind mount pins the file's inode: after wp-config.php
      # is re-rendered, php must be recreated to see it.
      - type: bind
        source: ./wp-config.php
        target: /var/www/wordpress/wp-config.php
        read_only: true
        bind:
          create_host_path: false
    deploy:
      resources:
        limits:
          cpus: "0.75"
          memory: 448M
        reservations:
          memory: 112M
    healthcheck:
      test: ["CMD", "/usr/local/bin/pressfleet-healthcheck"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
      start_interval: 2s

  nginx:
    <<: *site-container
    image: "ghcr.io/rchouinard/pressfleet/site-nginx:wp7.1.2"
    # nginx works without php (static files, health) and re-resolves "php"
    # every 10 s, but starting php first spares a new site those seconds of
    # 502s. Recreating php later does not restart nginx.
    depends_on:
      php:
        condition: service_started
    labels:
      pressfleet.managed: "true"
      pressfleet.site-id: "01k5z3m8q9r7t6v5w4x3y2z1ab"
      pressfleet.client-group-id: "01k5z3m8q9r7t6v5w4x3y2z1cg"
    volumes:
      - type: volume
        source: wp-content
        target: /var/www/wordpress/wp-content
        read_only: true
      - type: volume
        source: cache
        target: /var/cache/pressfleet/fastcgi
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: 64M
        reservations:
          memory: 16M
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8081/healthz"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 2s

# Named explicitly so the driver can attach platform services to it. No ports
# are published: Traefik reaches nginx over this network.
networks:
  site:
    name: "pf-01k5z3m8q9r7t6v5w4x3y2z1ab"
    labels:
      pressfleet.managed: "true"
      pressfleet.site-id: "01k5z3m8q9r7t6v5w4x3y2z1ab"
      pressfleet.client-group-id: "01k5z3m8q9r7t6v5w4x3y2z1cg"

volumes:
  # The site's only persistent data (§5.5).
  wp-content:
    labels:
      pressfleet.managed: "true"
      pressfleet.site-id: "01k5z3m8q9r7t6v5w4x3y2z1ab"
      pressfleet.client-group-id: "01k5z3m8q9r7t6v5w4x3y2z1cg"
  # FastCGI page cache, shared so Nginx Helper in php can purge it (§5.6).
  cache:
    labels:
      pressfleet.managed: "true"
      pressfleet.site-id: "01k5z3m8q9r7t6v5w4x3y2z1ab"
      pressfleet.client-group-id: "01k5z3m8q9r7t6v5w4x3y2z1cg"
