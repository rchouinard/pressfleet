# PressFleet MariaDB tuning. Generated by pressfleet; do not edit.
#
# Sized for a 768 MiB container limit shared by ~50 WordPress
# sites (design doc §4.1 Capacity Target). Rough worst case: buffer pool
# (384 MiB) + log buffer, Aria and key caches (~40 MiB) +
# max_connections x per-connection buffers (~1 MiB each) stays under the limit.
[mariadb]
skip-name-resolve
performance_schema = OFF
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# InnoDB holds all WordPress data; give it about half the memory.
innodb_buffer_pool_size = 384M
innodb_log_file_size = 96M
innodb_log_buffer_size = 16M
innodb_flush_log_at_trx_commit = 1

# Aria (internal temp tables) and MyISAM caches default to far more than
# a shared host can spare.
aria_pagecache_buffer_size = 16M
key_buffer_size = 8M

# PHP-FPM runs pm = ondemand, so most sites hold few or no connections.
# Idle connections are dropped quickly to keep the count down.
max_connections = 150
thread_cache_size = 32
wait_timeout = 300
interactive_timeout = 300

# Keep per-connection buffers small; they multiply by max_connections.
sort_buffer_size = 256K
join_buffer_size = 256K
read_buffer_size = 128K
read_rnd_buffer_size = 256K
tmp_table_size = 16M
max_heap_table_size = 16M
max_allowed_packet = 64M

# ~50 sites x a few dozen tables each.
table_open_cache = 4000
table_definition_cache = 3000
