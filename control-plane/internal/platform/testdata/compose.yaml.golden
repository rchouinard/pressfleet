# PressFleet platform services (design doc §4.1).
#
# Generated by the pressfleet host CLI from the platform definition embedded
# in its binary. Do not edit: changes are overwritten the next time the
# project is rendered (`pressfleet init`, `pressfleet upgrade`; §4.7).
# Credentials live in ./secrets/ (mode 0600), never in this file.
name: "pressfleet"

x-logging: &logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  control-plane:
    image: "ghcr.io/rchouinard/pressfleet/control-plane:v1.2.3"
    command: ["serve"]
    restart: unless-stopped
    # Reaps the docker/docker compose child processes the control plane runs.
    init: true
    environment:
      PRESSFLEET_DATA_DIR: "/var/lib/pressfleet"
      PRESSFLEET_LISTEN: ":8080"
      PRESSFLEET_MASTER_KEY_FILE: "/run/secrets/master_key"
      # Names the platform containers the control plane connects to site
      # networks, such as MariaDB.
      PRESSFLEET_PLATFORM_PROJECT: "pressfleet"
      PRESSFLEET_PREVIEW_BASE_DOMAIN: "preview.agency.example"
    volumes:
      # The data directory is mounted at the same absolute path as on the host.
      # The control plane starts helper containers (backups, restores) that
      # bind-mount subdirectories of <data_dir>/tmp/ from the host; those paths
      # are only valid if the control plane sees the data directory where the
      # host has it.
      - type: bind
        source: "/var/lib/pressfleet"
        target: "/var/lib/pressfleet"
      # Read-write Docker socket access is equivalent to root on the host. The
      # control plane is the only service that gets it (§6).
      - type: bind
        source: /var/run/docker.sock
        target: /var/run/docker.sock
    secrets:
      - mariadb_root_password
      - master_key
      - redis_admin_password
    networks:
      - platform
    deploy:
      resources:
        limits:
          memory: 192M
    healthcheck:
      test: ["CMD", "pressfleet", "healthcheck"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
      start_interval: 2s
    logging: *logging

  mariadb:
    image: "docker.io/library/mariadb:12.3.3@sha256:2f4f46f80e7251990bfdc601ae3f7f2964ddb4dc1868f7deca699fc1ece8c35e"
    restart: unless-stopped
    environment:
      MARIADB_ROOT_PASSWORD_FILE: /run/secrets/mariadb_root_password
      # Runs mariadb-upgrade after minor/patch image updates. Major version
      # upgrades only ship in major PressFleet releases (§4.7).
      MARIADB_AUTO_UPGRADE: "1"
    volumes:
      - type: volume
        source: mariadb-data
        target: /var/lib/mysql
      - type: bind
        source: ./mariadb/pressfleet.cnf
        target: /etc/mysql/conf.d/pressfleet.cnf
        read_only: true
    secrets:
      - mariadb_root_password
    networks:
      - platform
    deploy:
      resources:
        limits:
          memory: 768M
    # Give InnoDB time to flush on shutdown instead of being killed.
    stop_grace_period: 60s
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s
      start_interval: 2s
    logging: *logging

  # The shared object cache: Valkey, a Redis-compatible server
  # (images.yaml). The control plane connects it to each site network under
  # the alias pf-redis.
  redis:
    image: "docker.io/valkey/valkey:9.1.2@sha256:ac9c858b86dc81f3482d53a9d854547379a5f41e012500f839ab257c399063e0"
    command: ["valkey-server", "/etc/valkey/valkey.conf"]
    restart: unless-stopped
    # The image's own user; running as it from the start skips the
    # entrypoint's chown and privilege drop, so no capabilities are needed.
    user: "999:999"
    read_only: true
    cap_drop: [ALL]
    security_opt:
      - no-new-privileges:true
    # Nothing is persisted (see valkey.conf), so the working directory is a
    # small tmpfs rather than a volume.
    tmpfs:
      - /data:size=8m,mode=0700,uid=999,gid=999
    volumes:
      - type: bind
        source: ./redis/valkey.conf
        target: /etc/valkey/valkey.conf
        read_only: true
    networks:
      - platform
    deploy:
      resources:
        limits:
          memory: 320M
    healthcheck:
      test: ["CMD", "valkey-cli", "--no-auth-warning", "--user", "healthcheck", "--pass", "nopass", "-e", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
      start_interval: 1s
    logging: *logging

networks:
  platform: {}

volumes:
  mariadb-data: {}

secrets:
  mariadb_root_password:
    file: ./secrets/mariadb_root_password
  # Only the control plane gets the object cache admin password; the server
  # itself only knows its hash (redis/valkey.conf).
  redis_admin_password:
    file: ./secrets/redis_admin_password
  # The platform master key stays where the operator keeps it, outside the
  # data directory and its backups (§4.1); it is only mounted, never copied.
  master_key:
    file: "/etc/pressfleet/master.key"
