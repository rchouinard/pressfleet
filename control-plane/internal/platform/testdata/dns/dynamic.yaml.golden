# Traefik dynamic configuration for the PressFleet platform, read once at
# startup (file provider). Every other route comes from container labels.
#
# Generated by the pressfleet host CLI. Do not edit: changes are overwritten
# the next time the platform project is rendered (§4.7).

http:
  routers:
    # Makes Traefik obtain the preview wildcard certificate with DNS-01 as
    # soon as it starts, rather than when the first site appears. Traefik
    # then serves it for every <slug>.preview.agency.example and issues
    # nothing per site. The bare base domain itself hosts nothing.
    pf-preview-wildcard:
      rule: "Host(`preview.agency.example`)"
      entryPoints: [websecure]
      service: noop@internal
      tls:
        certResolver: acme-preview
        domains:
          - main: "preview.agency.example"
            sans: ["*.preview.agency.example"]
