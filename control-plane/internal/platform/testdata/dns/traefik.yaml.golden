# Traefik static configuration for the PressFleet platform (design doc §3, §6).
#
# Generated by the pressfleet host CLI. Do not edit: changes are overwritten
# the next time the platform project is rendered (§4.7).

global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: INFO
  format: json

# Access logs go to standard output, which Docker rotates like every other
# platform log. Request headers are dropped: they carry session cookies and
# basic auth credentials.
accessLog:
  format: json
  fields:
    headers:
      defaultMode: drop

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"
    # Routers that name no entry point listen here only.
    asDefault: true
    http:
      tls: {}
    # HTTP/2 comes with TLS; HTTP/3 needs UDP 443 published as well.
    http3: {}
  # Ping (the container healthcheck) and Prometheus metrics. Not published
  # on the host; the control plane scrapes it over the platform network.
  traefik:
    address: ":8082"

ping:
  entryPoint: traefik

metrics:
  prometheus:
    entryPoint: traefik
    addEntryPointsLabels: true
    addRoutersLabels: true
    addServicesLabels: true

providers:
  docker:
    # Read-only, allowlisted access to the Docker API through the socket
    # proxy. Traefik never mounts the Docker socket (§6).
    endpoint: "tcp://socket-proxy:2375"
    exposedByDefault: false
    # Only containers labelled for this platform are routed, so platforms
    # sharing a Docker engine (as the tests do) never pick up each other's
    # routes.
    constraints: "Label(`pressfleet.platform`, `pressfleet`)"
  # The maintenance page service, the router that requests the preview
  # wildcard certificate (with a DNS provider), and the maintenance routes
  # of sites in maintenance mode, which the control plane writes and removes
  # while Traefik runs.
  file:
    directory: "/etc/traefik/dynamic"
    watch: true

certificatesResolvers:
  # HTTP-01, one certificate per host name: the dashboard domain and, from
  # go-live on, sites' primary domains and aliases.
  acme-http:
    acme:
      email: "ops@agency.example"
      caServer: "https://pebble:14000/dir"
      storage: /var/lib/traefik/acme.json
      httpChallenge:
        entryPoint: web
  # Preview domains (<slug>.<preview base domain>).
  acme-preview:
    acme:
      email: "ops@agency.example"
      caServer: "https://pebble:14000/dir"
      storage: /var/lib/traefik/acme.json
      # One wildcard certificate for every preview domain, with DNS-01 (see
      # dynamic/platform.yaml). The provider's credentials come from the files the
      # entrypoint names in <VARIABLE>_FILE variables.
      dnsChallenge:
        provider: "cloudflare"
        resolvers:
          - "1.1.1.1:53"
          - "8.8.8.8:53"
