{{- /*
  The site's namespace (design doc §4.8): everything of one site lives in
  it, and deleting the site deletes it. Pod Security "restricted" is
  enforced on every pod in it (§6).
*/ -}}
# PressFleet site {{ .SiteID }} (design doc §4.8).
#
# Generated by the control plane from the site's record. Do not edit: changes
# are overwritten the next time the site is rendered.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ q .Namespace }}
  labels:
    app.kubernetes.io/managed-by: pressfleet
    pressfleet.io/site-id: {{ q .SiteID }}
    pressfleet.io/client-group-id: {{ q .ClientGroupID }}
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/enforce-version: latest
    pod-security.kubernetes.io/warn: restricted
    pod-security.kubernetes.io/warn-version: latest
