{{- /*
  Shared pieces of the site manifests. Only *.yaml.tmpl files become
  manifests; this file only defines templates that they include.
*/ -}}

{{- /* The header of every manifest file. */ -}}
{{- define "header" -}}
# PressFleet site {{ .SiteID }} (design doc §4.8).
#
# Generated by the control plane from the site's record. Do not edit: changes
# are overwritten the next time the site is rendered.
{{- end }}

{{- /*
  The labels of every object the driver renders. pressfleet.io/rendered
  marks the objects that come from these templates, which the driver deletes
  once no template renders them (kubernetes.RenderedLabel). Objects that
  other parts of the driver create in the namespace (task pods, the copies
  of image pull Secrets) don't have it.
*/ -}}
{{- define "labels" }}
    app.kubernetes.io/managed-by: pressfleet
    pressfleet.io/rendered: "true"
    pressfleet.io/site-id: {{ q .SiteID }}
    pressfleet.io/client-group-id: {{ q .ClientGroupID }}
{{- end }}

{{- /*
  The labels of the site's pod, which the Deployment creates rather than
  the driver: no pressfleet.io/rendered.
*/ -}}
{{- define "pod-labels" }}
        app.kubernetes.io/managed-by: pressfleet
        pressfleet.io/site-id: {{ q .SiteID }}
        pressfleet.io/client-group-id: {{ q .ClientGroupID }}
{{- end }}
