{{- /*
  The site's maintenance routes (#217, design doc §5.4): a twin of each of
  its routers, at a higher priority, pointing at the platform's maintenance
  page. Not a manifest of the site's namespace: Traefik runs with
  allowCrossNamespace: false, so the routes live in the platform namespace,
  next to the maintenance Service. The driver applies them only while the
  site is in maintenance mode, and finds them by the maintenance-for label.
*/ -}}
# Maintenance routes of PressFleet site {{ .SiteID }} (design doc §5.4).
#
# Generated by the control plane. While the site is in maintenance mode they
# are applied to the platform namespace. Do not edit: changes are overwritten
# the next time the site is rendered.
{{- range .Maintenance.Routes }}
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: {{ q .Name }}
  namespace: {{ q $.PlatformNamespace }}
  labels:
    app.kubernetes.io/managed-by: pressfleet
    pressfleet.io/maintenance-for: {{ q $.SiteID }}
spec:
  entryPoints:
    - {{ q $.Routing.EntryPoint }}
  routes:
    - kind: Rule
      match: {{ q .Rule }}
      priority: {{ .Priority }}
      services:
        - name: {{ q $.Maintenance.Service }}
          port: {{ $.Maintenance.Port }}
  tls:
    certResolver: {{ q .CertResolver }}
{{- end }}
