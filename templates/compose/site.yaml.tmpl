{{- /*
  One site's Compose project (design doc §4.1), rendered by
  compose.RenderSite into <data_dir>/sites/<site-id>/ next to wp-config.php.
  The container side follows the site image runtime contract in
  images/README.md.

  Traefik router labels go on nginx only; the driver builds them
  (compose/routing.go). The Traefik, MariaDB, and Redis platform containers
  join the site network from outside, under the aliases the driver sets
  (compose.TraefikAlias, compose.MariaDBAlias, compose.RedisAlias).
*/ -}}
# PressFleet site {{ .SiteID }} (design doc §4.1).
#
# Generated by the control plane from the site's record. Do not edit: changes
# are overwritten the next time the site is rendered. The site's credentials
# are in ./wp-config.php (mounted into php only), never in this file.
name: {{ q .Project }}

x-logging: &logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

# Settings both site containers share. They run as the site's own UID and GID
# (§6), which must be the same in both: nginx reads the files PHP writes to
# wp-content, and PHP deletes nginx's FastCGI cache files (§5.6). Neither
# image needs root, capabilities, or a writable root filesystem.
x-site-container: &site-container
  user: "{{ .UID }}:{{ .UID }}"
  restart: unless-stopped
  read_only: true
  tmpfs:
    - /tmp
  cap_drop:
    - ALL
  security_opt:
    - "no-new-privileges:true"
  networks:
    - site
  logging: *logging

services:
  php:
    <<: *site-container
    image: {{ q .Images.PHP }}
    labels:
{{- template "labels" . }}
    environment:
      # Derived from php's memory limit (compose.splitResources).
      PHP_MEMORY_LIMIT: {{ q .PHPMemoryLimit }}
      PHP_FPM_MAX_CHILDREN: {{ q .PHPMaxChildren }}
    volumes:
      - type: volume
        source: wp-content
        target: /var/www/wordpress/wp-content
      - type: volume
        source: cache
        target: /var/cache/pressfleet/fastcgi
      # A single-file bind mount pins the file's inode: after wp-config.php
      # is re-rendered, php must be recreated to see it.
      - type: bind
        source: ./{{ .WPConfigFile }}
        target: /var/www/wordpress/wp-config.php
        read_only: true
        bind:
          create_host_path: false
    deploy:
      resources:
        limits:
          cpus: {{ q .PHP.CPUs }}
          memory: {{ .PHP.MemoryLimitMB }}M
        reservations:
          memory: {{ .PHP.MemoryReservationMB }}M
    healthcheck:
      test: ["CMD", "/usr/local/bin/pressfleet-healthcheck"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
      start_interval: 2s

  nginx:
    <<: *site-container
    image: {{ q .Images.Nginx }}
    # nginx works without php (static files, health) and re-resolves "php"
    # every 10 s, but starting php first spares a new site those seconds of
    # 502s. Recreating php later does not restart nginx.
    depends_on:
      php:
        condition: service_started
    labels:
{{- template "labels" . }}
{{- if .RoutingLabels }}
      # Traefik routes the site's domains here (package ingress documents
      # the names). Only nginx is routed; php is never reachable from
      # outside the site network.
{{- range .RoutingLabels }}
      {{ .Key }}: {{ q .Value }}
{{- end }}
{{- end }}
    environment:
      # FastCGI page cache (SiteConfig.EnableCache). The cache volume below
      # holds it; php purges it (§5.6).
      NGINX_FASTCGI_CACHE: {{ if .EnableCache }}"on"{{ else }}"off"{{ end }}
      # WordPress security set (§6.1), install-wide.
{{- if .NginxSecurity.LoginRateLimit }}
      NGINX_LOGIN_RATE_LIMIT: "on"
      NGINX_LOGIN_RATE: {{ q .NginxSecurity.LoginRate }}
      NGINX_LOGIN_BURST: {{ q .NginxSecurity.LoginBurst }}
{{- else }}
      NGINX_LOGIN_RATE_LIMIT: "off"
{{- end }}
      NGINX_SECURITY_HEADERS: {{ if .NginxSecurity.SecurityHeaders }}"on"{{ else }}"off"{{ end }}
    volumes:
      - type: volume
        source: wp-content
        target: /var/www/wordpress/wp-content
        read_only: true
      - type: volume
        source: cache
        target: /var/cache/pressfleet/fastcgi
    deploy:
      resources:
        limits:
          cpus: {{ q .Nginx.CPUs }}
          memory: {{ .Nginx.MemoryLimitMB }}M
        reservations:
          memory: {{ .Nginx.MemoryReservationMB }}M
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8081/healthz"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 2s

# Named explicitly so the driver can attach platform services to it. No ports
# are published: Traefik reaches nginx over this network.
networks:
  site:
    name: {{ q .Network }}
    labels:
{{- template "labels" . }}

volumes:
  # The site's only persistent data (§5.5).
  wp-content:
    labels:
{{- template "labels" . }}
  # FastCGI page cache, shared so Nginx Helper in php can purge it (§5.6).
  cache:
    labels:
{{- template "labels" . }}
{{- define "labels" }}
      pressfleet.managed: "true"
      pressfleet.site-id: {{ q .SiteID }}
      pressfleet.client-group-id: {{ q .ClientGroupID }}
{{- end }}
