# PressFleet platform services (design doc §4.1).
#
# Generated by the pressfleet host CLI from the platform definition embedded
# in its binary. Do not edit: changes are overwritten the next time the
# project is rendered (`pressfleet init`, `pressfleet upgrade`; §4.7).
# Credentials live in ./secrets/ (mode 0600), never in this file.
name: {{ q .ProjectName }}

x-logging: &logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  control-plane:
    image: {{ q .Images.ControlPlane }}
    command: ["serve"]
    restart: unless-stopped
    # Reaps the docker/docker compose child processes the control plane runs.
    init: true
    environment:
      PRESSFLEET_DATA_DIR: {{ q .DataDir }}
      PRESSFLEET_LISTEN: {{ q .Listen }}
      PRESSFLEET_MASTER_KEY_FILE: {{ q .MasterKeySecretPath }}
      # Names the platform containers the control plane connects to site
      # networks, such as MariaDB.
      PRESSFLEET_PLATFORM_PROJECT: {{ q .ProjectName }}
      # Backup and restore tasks run in the control plane's own image, which
      # ships restic and the MariaDB client (design doc §5.3).
      PRESSFLEET_TASK_IMAGE: {{ q .Images.ControlPlane }}
{{- if .PreviewBaseDomain }}
      PRESSFLEET_PREVIEW_BASE_DOMAIN: {{ q .PreviewBaseDomain }}
{{- end }}
{{- if .DashboardDomain }}
      PRESSFLEET_DASHBOARD_DOMAIN: {{ q .DashboardDomain }}
{{- end }}
{{- if .PublicIP }}
      # Where custom domains must point for a site to go live (§5.2).
      PRESSFLEET_PUBLIC_IP: {{ q .PublicIP }}
{{- end }}
{{- if .ACME.DNSProvider }}
      # The control plane decrypts the DNS provider credentials (encrypted
      # with the master key) for Traefik when it starts.
      PRESSFLEET_ACME_DNS_PROVIDER: {{ q .ACME.DNSProvider }}
{{- if .ACME.DNSCredentials }}
      PRESSFLEET_ACME_DNS_CREDENTIALS: {{ q .ACME.DNSCredentials }}
{{- end }}
{{- end }}
{{- if .SkipPreflight }}
      # Development/CI only: start even if required host checks fail.
      PRESSFLEET_SKIP_PREFLIGHT: "true"
{{- end }}
{{- with .SMTP }}
      # The relay sites send email through (§5.6). The password is encrypted
      # with the master key; the control plane decrypts it at startup.
      PRESSFLEET_SMTP_HOST: {{ q .Host }}
{{- if .Port }}
      PRESSFLEET_SMTP_PORT: {{ q (print .Port) }}
{{- end }}
      PRESSFLEET_SMTP_ENCRYPTION: {{ q .Encryption }}
{{- if .Username }}
      PRESSFLEET_SMTP_USERNAME: {{ q .Username }}
      PRESSFLEET_SMTP_PASSWORD: {{ q .Password }}
{{- end }}
{{- if .FromEmail }}
      PRESSFLEET_SMTP_FROM_EMAIL: {{ q .FromEmail }}
{{- end }}
{{- if .FromName }}
      PRESSFLEET_SMTP_FROM_NAME: {{ q .FromName }}
{{- end }}
{{- end }}
    volumes:
      # The data directory is mounted at the same absolute path as on the host.
      # The control plane starts helper containers (backups, restores) that
      # bind-mount subdirectories of <data_dir>/tmp/ from the host; those paths
      # are only valid if the control plane sees the data directory where the
      # host has it.
      - type: bind
        source: {{ q .DataDir }}
        target: {{ q .DataDir }}
      # Read-write Docker socket access is equivalent to root on the host. The
      # control plane is the only service that gets it (§6).
      - type: bind
        source: /var/run/docker.sock
        target: /var/run/docker.sock
{{- if .ACME.DNSProvider }}
      # The control plane decrypts the DNS provider credentials here for
      # Traefik.
      - type: volume
        source: acme-dns-credentials
        target: {{ q .DNSCredentialsDir }}
{{- end }}
    secrets:
      - mariadb_root_password
      - master_key
      - redis_admin_password
    networks:
      - platform
{{- if .DashboardDomain }}
    # Traefik serves the dashboard and API on the dashboard domain.
    labels:
      {{ .PlatformLabel }}: {{ q .ProjectName }}
      traefik.enable: "true"
      traefik.docker.network: {{ q (printf "%s_platform" .ProjectName) }}
      traefik.http.routers.pf-dashboard.rule: {{ q (printf "Host(%s)" (backquote .DashboardDomain)) }}
      traefik.http.routers.pf-dashboard.entrypoints: {{ q .EntryPointHTTPS }}
      traefik.http.routers.pf-dashboard.tls.certresolver: {{ q .CertResolverHTTP }}
      traefik.http.routers.pf-dashboard.service: pf-dashboard
      traefik.http.services.pf-dashboard.loadbalancer.server.port: "{{ .ListenPort }}"
{{- end }}
    deploy:
      resources:
        limits:
          memory: {{ .ControlPlaneMemoryMB }}M
    healthcheck:
      test: ["CMD", "pressfleet", "healthcheck"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
      start_interval: 2s
    logging: *logging

  mariadb:
    image: {{ q .Images.MariaDB }}
    restart: unless-stopped
    environment:
      MARIADB_ROOT_PASSWORD_FILE: /run/secrets/mariadb_root_password
      # Runs mariadb-upgrade after minor/patch image updates. Major version
      # upgrades only ship in major PressFleet releases (§4.7).
      MARIADB_AUTO_UPGRADE: "1"
    volumes:
      - type: volume
        source: mariadb-data
        target: /var/lib/mysql
      - type: bind
        source: ./mariadb/pressfleet.cnf
        target: /etc/mysql/conf.d/pressfleet.cnf
        read_only: true
    secrets:
      - mariadb_root_password
    networks:
      - platform
    deploy:
      resources:
        limits:
          memory: {{ .MariaDBMemoryMB }}M
    # Give InnoDB time to flush on shutdown instead of being killed.
    stop_grace_period: 60s
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s
      start_interval: 2s
    logging: *logging

  # The shared object cache: Valkey, a Redis-compatible server
  # (images.yaml). The control plane connects it to each site network under
  # the alias pf-redis.
  redis:
    image: {{ q .Images.Redis }}
    command: ["valkey-server", "/etc/valkey/valkey.conf"]
    restart: unless-stopped
    # The image's own user; running as it from the start skips the
    # entrypoint's chown and privilege drop, so no capabilities are needed.
    user: "999:999"
    read_only: true
    cap_drop: [ALL]
    security_opt:
      - no-new-privileges:true
    # Nothing is persisted (see valkey.conf), so the working directory is a
    # small tmpfs rather than a volume.
    tmpfs:
      - /data:size=8m,mode=0700,uid=999,gid=999
    volumes:
      - type: bind
        source: ./redis/valkey.conf
        target: /etc/valkey/valkey.conf
        read_only: true
    networks:
      - platform
    deploy:
      resources:
        limits:
          memory: {{ .RedisMemoryMB }}M
    healthcheck:
      test: ["CMD", "valkey-cli", "--no-auth-warning", "--user", "healthcheck", "--pass", "nopass", "-e", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
      start_interval: 1s
    logging: *logging

  # The edge router for all web traffic (design doc §3). It learns routes
  # from container labels through the socket proxy and never mounts the
  # Docker socket itself (§6).
  {{ .TraefikService }}:
    image: {{ q .Images.Traefik }}
{{- if .ACME.DNSProvider }}
    # Waits for the DNS provider credentials, then starts Traefik.
    entrypoint: ["/bin/sh", "/etc/traefik/entrypoint.sh"]
{{- else }}
    command: ["traefik", "--configFile=/etc/traefik/traefik.yaml"]
{{- end }}
    restart: unless-stopped
    ports:
      - "80:80/tcp"
      - "443:443/tcp"
      # HTTP/3
      - "443:443/udp"
    environment:
      # Lets the Go runtime collect garbage harder before the memory limit
      # is reached instead of being killed at it.
      GOMEMLIMIT: "{{ .TraefikGoMemLimitMB }}MiB"
{{- if .ACME.CACertificates }}
      # Extra roots to trust for the ACME server, on top of the system's.
      LEGO_CA_CERTIFICATES: /etc/traefik/acme-ca.pem
      LEGO_CA_SYSTEM_CERT_POOL: "true"
{{- end }}
    volumes:
      - type: bind
        source: ./traefik/traefik.yaml
        target: /etc/traefik/traefik.yaml
        read_only: true
      # File provider configuration, including the maintenance routes the
      # control plane writes (it has the data directory mounted).
      - type: bind
        source: ./{{ .DynamicConfigSource }}
        target: {{ q .DynamicConfigDir }}
        read_only: true
{{- if .ACME.DNSProvider }}
      - type: bind
        source: ./traefik/entrypoint.sh
        target: /etc/traefik/entrypoint.sh
        read_only: true
      - type: volume
        source: acme-dns-credentials
        target: {{ q .DNSCredentialsDir }}
        read_only: true
{{- end }}
{{- if .ACME.CACertificates }}
      - type: bind
        source: {{ q .ACME.CACertificates }}
        target: /etc/traefik/acme-ca.pem
        read_only: true
{{- end }}
      # ACME account keys and certificates (acme.json).
      - type: volume
        source: traefik-acme
        target: /var/lib/traefik
    networks:
      - platform
      - socket-proxy
    depends_on:
      socket-proxy:
        condition: service_healthy
    read_only: true
    cap_drop: [ALL]
    cap_add: [NET_BIND_SERVICE]
    security_opt: ["no-new-privileges:true"]
    deploy:
      resources:
        limits:
          memory: {{ .TraefikMemoryMB }}M
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--configFile=/etc/traefik/traefik.yaml"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
      start_interval: 2s
    logging: *logging

  # The page Traefik shows for sites in maintenance mode (design doc §5.4):
  # 503 with Retry-After on every path. It is the control plane image
  # running a static page server, with no data, secrets, Docker socket, or
  # writable filesystem, so public traffic for a site under maintenance
  # never reaches the control plane itself.
  {{ .MaintenanceHost }}:
    image: {{ q .Images.ControlPlane }}
    command: ["maintenance-page", "--listen", ":{{ .MaintenancePort }}"]
    restart: unless-stopped
    user: "65534:65534"
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    environment:
      GOMEMLIMIT: "{{ .MaintenanceGoMemLimitMB }}MiB"
    networks:
      - platform
    deploy:
      resources:
        limits:
          memory: {{ .MaintenanceMemoryMB }}M
    healthcheck:
      test: ["CMD", "pressfleet", "maintenance-page", "--check", "--listen", ":{{ .MaintenancePort }}"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    logging: *logging

  # Traefik's only way to the Docker API: read-only requests for exactly the
  # endpoints its Docker provider uses, from the Traefik container only.
  # Everything else (writes, logs, exec, file archives) is refused.
  socket-proxy:
    image: {{ q .Images.SocketProxy }}
    command:
      - "-listenip=0.0.0.0"
      - "-allowfrom={{ .TraefikService }}"
      - "-allowHEAD=/_ping"
      - "-allowGET=/v1\\.[0-9]{1,3}/(version|containers/json|containers/[0-9a-f]{64}/json|events)"
      - "-allowhealthcheck"
      # Exit if the Docker socket goes away (e.g. the engine restarted), so
      # Docker restarts the proxy with a fresh connection.
      - "-watchdoginterval=60"
      - "-stoponwatchdog"
      - "-shutdowngracetime=5"
    restart: unless-stopped
    # The socket belongs to root on the host. Root here has no capabilities
    # and a read-only filesystem; it only needs to open the socket.
    user: "0:0"
    volumes:
      - type: bind
        source: /var/run/docker.sock
        target: /var/run/docker.sock
        read_only: true
    networks:
      - socket-proxy
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    deploy:
      resources:
        limits:
          memory: {{ .SocketProxyMemoryMB }}M
    healthcheck:
      test: ["CMD", "./healthcheck"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    logging: *logging

networks:
  platform: {}
  # Only Traefik and the socket proxy; no route out of the host.
  socket-proxy:
    internal: true

volumes:
  mariadb-data: {}
  traefik-acme: {}
{{- if .ACME.DNSProvider }}
  # Decrypted DNS provider credentials, in memory only: never written to
  # disk, and gone when the platform stops.
  acme-dns-credentials:
    driver_opts:
      type: tmpfs
      device: tmpfs
      o: "size=1m,mode=0700"
{{- end }}

secrets:
  mariadb_root_password:
    file: ./secrets/mariadb_root_password
  # Only the control plane gets the object cache admin password; the server
  # itself only knows its hash (redis/valkey.conf).
  redis_admin_password:
    file: ./secrets/redis_admin_password
  # The platform master key stays where the operator keeps it, outside the
  # data directory and its backups (§4.1); it is only mounted, never copied.
  master_key:
    file: {{ q .MasterKeyFile }}
