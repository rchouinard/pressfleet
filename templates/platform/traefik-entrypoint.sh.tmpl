#!/bin/sh
# Starts Traefik with the DNS provider's credentials (docs/configuration.md,
# "Preview certificates").
#
# Generated by the pressfleet host CLI. Do not edit: changes are overwritten
# the next time the platform project is rendered (§4.7).
#
# The control plane decrypts the credentials into {{ .DNSCredentialsDir }}, a
# memory-only volume, one file per environment variable the provider reads,
# then writes {{ .DNSCredentialsReady }}. Traefik gets <VARIABLE>_FILE pointing
# at each file, so the values never appear in its environment or in the
# container's configuration. Traefik reads them when it first needs the DNS
# provider and keeps them, so recreate Traefik after changing them.
set -eu

dir={{ .DNSCredentialsDir }}
# On a reboot, Docker may start Traefik before the control plane. Give the
# control plane time to write the credentials, but don't hold up site
# traffic for long: without them, Traefik still serves the certificates it
# has, and only can't get new wildcard certificates.
waited=0
while [ ! -e "$dir/{{ .DNSCredentialsReady }}" ] && [ "$waited" -lt 60 ]; do
	sleep 1
	waited=$((waited + 1))
done
if [ ! -e "$dir/{{ .DNSCredentialsReady }}" ]; then
	echo "pressfleet: DNS provider credentials not written after 60s; starting Traefik without them" >&2
fi

found=0
for f in "$dir"/*; do
	[ -f "$f" ] || continue
	name=${f##*/}
	# A file name that isn't a shell identifier can't be exported, and the failed
	# export would abort the shell and stop Traefik from starting.
	case $name in
	'' | [0-9]* | *[!A-Za-z0-9_]*)
		echo "pressfleet: skipping DNS provider credential file with an invalid variable name: $name" >&2
		continue
		;;
	esac
	export "${name}_FILE=$f"
	found=$((found + 1))
done
echo "pressfleet: starting Traefik with $found DNS provider credential(s)" >&2

exec traefik --configFile=/etc/traefik/traefik.yaml
