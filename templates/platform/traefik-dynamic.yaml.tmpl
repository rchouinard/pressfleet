# Traefik dynamic configuration for the PressFleet platform (file provider).
# Site routes come from container labels; the control plane adds a file next
# to this one for each site in maintenance mode (package ingress).
#
# Generated by the pressfleet host CLI. Do not edit: changes are overwritten
# the next time the platform project is rendered (§4.7).

http:
  services:
    # The maintenance page (design doc §5.4) that maintenance routers send
    # visitors to.
    {{ .MaintenanceService }}:
      loadBalancer:
        servers:
          - url: {{ yq (printf "http://%s:%d" .MaintenanceHost .MaintenancePort) }}
{{- if .ACME.DNSProvider }}
  routers:
    # Makes Traefik obtain the preview wildcard certificate with DNS-01 as
    # soon as it starts, rather than when the first site appears. Traefik
    # then serves it for every <slug>.{{ .PreviewBaseDomain }} and issues
    # nothing per site. The bare base domain itself hosts nothing.
    {{ .PreviewWildcardRouter }}:
      rule: {{ yq (printf "Host(%s)" (backquote .PreviewBaseDomain)) }}
      entryPoints: [{{ .EntryPointHTTPS }}]
      service: noop@internal
      tls:
        certResolver: {{ .CertResolverPreview }}
        domains:
          - main: {{ yq .PreviewBaseDomain }}
            sans: [{{ yq (printf "*.%s" .PreviewBaseDomain) }}]
{{- end }}
