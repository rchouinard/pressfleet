# PressFleet object cache (Valkey) configuration. Generated by pressfleet; do
# not edit.
#
# One server is shared by every site (design doc §3, §6). The control plane
# gives each site its own ACL user, logical database, and key prefix at run
# time; this file only defines the server and the platform's own users.

# Only the platform network and site networks reach the server, and every
# client must authenticate (the default user is off), so protected mode, which
# refuses remote clients when the default user has no password, is not needed.
bind * -::*
protected-mode no
port 6379

# Each site gets one logical database (restricted with a db=<n> ACL rule), so
# one site's SCAN, DBSIZE, and FLUSHDB never see another's keys. Database 0 is
# left unused. Empty databases cost almost nothing.
databases {{ .RedisDatabases }}

# The cache is sized by the §4.1 capacity budget. WordPress stores most
# object cache entries without a TTL, so volatile-lru would find nothing to
# evict and writes would fail once memory is full; allkeys-lru evicts the
# least recently used entries of any site instead.
maxmemory {{ .RedisMaxMemoryMB }}mb
maxmemory-policy allkeys-lru

# No persistence: it is a cache, and WordPress rebuilds it on demand. RDB
# snapshots would fork the server (doubling memory under write load) and
# append-only files would add disk I/O for data nobody needs after a restart.
save ""
appendonly no

# Free memory in a background thread, so a site flushing its database or a
# burst of evictions doesn't stall every other site's requests.
lazyfree-lazy-user-flush yes
lazyfree-lazy-eviction yes

# Users. Passwords are given as SHA-256 hashes ("#<hex>"), so this file never
# holds a usable credential.
#
# The default user is disabled and stripped of all permissions.
user default off resetpass resetkeys resetchannels -@all
# The container healthcheck can only PING.
user healthcheck on nopass resetkeys resetchannels -@all +ping
# The control plane manages site users and databases.
user {{ .RedisAdminUser }} on #{{ .RedisAdminPasswordHash }} ~* &* alldbs +@all
