# Traefik dynamic configuration that exposes VictoriaMetrics' read-only
# query API for the agency's own Grafana (metrics.public_domain, design doc
# §7). Only the paths of MetricsPublicPaths are routed, behind HTTP basic
# auth; every other path, the write and admin APIs included, answers 404.
#
# Generated by the pressfleet host CLI. Do not edit: changes are overwritten
# the next time the platform project is rendered or the credential is
# rotated (pressfleet metrics-access rotate).

http:
  routers:
    {{ .MetricsRouter }}:
      rule: {{ yq .MetricsRule }}
      entryPoints: [{{ .EntryPointHTTPS }}]
      middlewares: [{{ .MetricsAuthMiddleware }}]
      service: {{ .MetricsRouter }}
      tls:
        certResolver: {{ .CertResolverHTTP }}
  middlewares:
    {{ .MetricsAuthMiddleware }}:
      basicAuth:
        # The bcrypt hash of a random password; the password is shown once.
        users:
          - {{ yq (printf "%s:%s" .MetricsUsername .MetricsPasswordHash) }}
        # VictoriaMetrics never sees the credential.
        removeHeader: true
        realm: PressFleet metrics
  services:
    {{ .MetricsRouter }}:
      loadBalancer:
        servers:
          - url: {{ yq (printf "http://%s:%d" .VictoriaMetricsService .VictoriaMetricsPort) }}
