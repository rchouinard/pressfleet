# Versions built by `make images` and `make images-test`. Shell-sourceable.
# Issue #20 replaces this with the image matrix and version manifest.

# PHP branches with active or security support (php.net/supported-versions.php,
# checked 2026-09-26). 8.2 reaches end of life on 2026-12-31.
PHP_VERSIONS="8.2 8.3 8.4 8.5"

# Latest WordPress release (api.wordpress.org/core/version-check/1.7/) and the
# SHA-1 of its tarball (wordpress.org/wordpress-<version>.tar.gz.sha1).
WP_VERSION=7.1.2
WP_SHA1=761b8101538f0631a0bfc4fba7bc4abeea92f81c
