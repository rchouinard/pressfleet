{
  "name": "pressfleet-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o app/api/schema.gen.ts",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck && tsc -p e2e",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.138",
    "@nuxt/ui": "^4.11.3",
    "nuxt": "^4.5.2",
    "openapi-fetch": "^0.17.0",
    "tailwindcss": "^4.3.3",
    "uplot": "^1.6.32",
    "uqr": "0.1.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  }
}
