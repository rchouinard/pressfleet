# Copy to .env (gitignored) for `make dev-up`; see CONTRIBUTING.md.

# A domain you own on Cloudflare. The dashboard is served at this name and
# previews at <slug>.preview.<this name>. Both must be DNS-only A records
# pointing at 127.0.0.1: PF_DEV_DOMAIN and *.preview.PF_DEV_DOMAIN.
PF_DEV_DOMAIN=

# Cloudflare API token that can edit DNS for that zone (DNS-01 wildcard cert).
CF_DNS_API_TOKEN=

# Optional.
# PF_DEV_ADMIN_EMAIL=admin@<PF_DEV_DOMAIN>
# PF_DEV_ADMIN_PASSWORD=pressfleet-dev-password
# PF_DEV_STAGING=1   # Let's Encrypt staging: untrusted by browsers, high rate limits
