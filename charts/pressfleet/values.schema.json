{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "PressFleet chart values",
  "description": "See values.yaml. Unknown keys are rejected, as in the config file, so that a typo is an error rather than a setting silently ignored.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "domain": {
      "type": "string",
      "pattern": "^$|^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
    },
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "dnsSubdomain": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"
    },
    "optionalDNSSubdomain": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"
    },
    "secretKey": {
      "type": "string",
      "pattern": "^[-._a-zA-Z0-9]+$"
    },
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretName", "key"],
      "properties": {
        "secretName": { "$ref": "#/definitions/dnsSubdomain" },
        "key": { "$ref": "#/definitions/secretKey" }
      }
    },
    "optionalSecretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretName", "key"],
      "properties": {
        "secretName": { "$ref": "#/definitions/optionalDNSSubdomain" },
        "key": { "$ref": "#/definitions/secretKey" }
      }
    },
    "image": {
      "type": "string",
      "pattern": "^$|^[a-z0-9][^\\s]*$"
    },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|k|M|G|T|P)?$"
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "storageClass"],
      "properties": {
        "size": { "$ref": "#/definitions/quantity" },
        "storageClass": { "$ref": "#/definitions/optionalDNSSubdomain" }
      }
    },
    "nodePort": {
      "type": "integer",
      "oneOf": [
        { "const": 0 },
        { "minimum": 1, "maximum": 65535 }
      ]
    }
  },
  "required": ["kubernetes", "masterKey", "platformSecrets", "database", "controlPlane", "mariadb", "traefik", "sftp"],
  "properties": {
    "global": {
      "description": "Helm's own; unused.",
      "type": "object"
    },
    "dashboardDomain": { "$ref": "#/definitions/domain" },
    "previewBaseDomain": { "$ref": "#/definitions/domain" },
    "publicIP": {
      "type": "string",
      "anyOf": [
        { "const": "" },
        { "format": "ipv4" },
        { "format": "ipv6" }
      ]
    },
    "kubernetes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["siteNamespacePrefix", "podCIDRs", "storageClasses", "imagePullSecrets"],
      "properties": {
        "siteNamespacePrefix": {
          "description": "kubernetes.site_namespace_prefix: at most 37 characters, since site IDs take 26 of a namespace name's 63.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 37
        },
        "podCIDRs": {
          "description": "kubernetes.pod_cidrs, required with the Kubernetes driver.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$|^[0-9a-fA-F:]+/[0-9]{1,3}$"
          }
        },
        "storageClasses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sites", "data"],
          "properties": {
            "sites": { "$ref": "#/definitions/optionalDNSSubdomain" },
            "data": { "$ref": "#/definitions/optionalDNSSubdomain" }
          }
        },
        "imagePullSecrets": {
          "type": "array",
          "items": { "$ref": "#/definitions/dnsSubdomain" }
        }
      }
    },
    "config": { "$ref": "#/definitions/optionalSecretRef" },
    "masterKey": { "$ref": "#/definitions/secretRef" },
    "platformSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretName", "mariadbRootPasswordKey", "redisAdminPasswordKey", "sshHostKeyKey"],
      "properties": {
        "secretName": { "$ref": "#/definitions/dnsSubdomain" },
        "mariadbRootPasswordKey": { "$ref": "#/definitions/secretKey" },
        "redisAdminPasswordKey": { "$ref": "#/definitions/secretKey" },
        "sshHostKeyKey": { "$ref": "#/definitions/secretKey" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postgresDSN"],
      "properties": {
        "postgresDSN": { "$ref": "#/definitions/secretRef" }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controlPlane": { "$ref": "#/definitions/image" },
        "mariadb": { "$ref": "#/definitions/image" },
        "redis": { "$ref": "#/definitions/image" },
        "traefik": { "$ref": "#/definitions/image" },
        "victoriaMetrics": { "$ref": "#/definitions/image" }
      }
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memoryMB", "uid", "gid", "data"],
      "properties": {
        "memoryMB": { "type": "integer", "minimum": 64 },
        "uid": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "gid": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "existingClaim"],
          "properties": {
            "size": { "$ref": "#/definitions/quantity" },
            "existingClaim": { "$ref": "#/definitions/optionalDNSSubdomain" }
          }
        }
      }
    },
    "mariadb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "address", "memoryMB", "storage"],
      "properties": {
        "enabled": { "type": "boolean" },
        "address": {
          "description": "host:port of an external MariaDB (mariadb.address).",
          "type": "string",
          "pattern": "^$|^[^\\s:]+:[0-9]{1,5}$|^\\[[0-9a-fA-F:]+\\]:[0-9]{1,5}$"
        },
        "memoryMB": { "type": "integer", "minimum": 512 },
        "storage": { "$ref": "#/definitions/storage" }
      },
      "if": { "properties": { "enabled": { "const": false } } },
      "then": { "properties": { "address": { "minLength": 1 } } },
      "else": { "properties": { "address": { "const": "" } } }
    },
    "redis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxMemoryMB"],
      "properties": {
        "maxMemoryMB": { "type": "integer", "minimum": 32 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retentionDays"],
      "properties": {
        "retentionDays": { "type": "integer", "minimum": 1, "maximum": 3660 }
      }
    },
    "victoriaMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memoryMB", "storage"],
      "properties": {
        "memoryMB": { "type": "integer", "minimum": 64 },
        "storage": { "$ref": "#/definitions/storage" }
      }
    },
    "traefik": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memoryMB", "storage", "service"],
      "properties": {
        "memoryMB": { "type": "integer", "minimum": 32 },
        "storage": { "$ref": "#/definitions/storage" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "externalTrafficPolicy", "annotations", "nodePorts", "http3"],
          "properties": {
            "type": { "enum": ["LoadBalancer", "NodePort"] },
            "externalTrafficPolicy": { "enum": ["Local", "Cluster"] },
            "annotations": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "nodePorts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "web": { "$ref": "#/definitions/nodePort" },
                "websecure": { "$ref": "#/definitions/nodePort" },
                "sftp": { "$ref": "#/definitions/nodePort" }
              }
            },
            "http3": { "type": "boolean" }
          }
        }
      }
    },
    "acme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": { "type": "string" },
        "caServer": {
          "description": "acme.ca_server: https:// only.",
          "type": "string",
          "pattern": "^$|^https://"
        },
        "staging": { "type": "boolean" },
        "dnsProvider": {
          "type": "string",
          "pattern": "^$|^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "dnsCredentialsSecret": { "$ref": "#/definitions/optionalDNSSubdomain" },
        "dnsResolvers": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[^\\s]+:[0-9]{1,5}$" }
        },
        "caCertificates": { "$ref": "#/definitions/optionalSecretRef" }
      }
    },
    "sftp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": {
          "description": "sftp.port: not 80 or 443, which Traefik's web entry points take.",
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "not": { "enum": [80, 443] }
        }
      }
    }
  }
}
